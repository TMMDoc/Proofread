/PROG  BG_COMBINED
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "A_Scale+Gauge+BG";
PROG_SIZE	= 2808;
CREATE		= DATE 26-05-06  TIME 15:01:06;
MODIFIED	= DATE 26-06-03  TIME 12:58:22;
FILE_NAME	= ;
VERSION		= 0;
LINE_COUNT	= 122;
MEMORY_SIZE	= 3172;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= 1,*,*,*,*;
CONTROL_CODE	= 00000000 00000000;
LOCAL_REGISTERS	= 0,0,0;
/MN
   1:  !-------------------------------- ;
   2:  ! SECTION 1: A_SCALE ;
   3:  ! Analog inputs + GI signed conv ;
   4:  !-------------------------------- ;
   5:  R[1:RAW_VAL_Z1]=AI[2]    ;
   6:  R[2:ANA_VAL_Z1]=R[1:RAW_VAL_Z1]/209    ;
   7:  R[4:RAW_VAL_Z2]=AI[1]    ;
   8:  R[5:ANA_VAL_Z2]=R[4:RAW_VAL_Z2]/212    ;
   9:  IF (GI[6:ShftdFrame_Mac_Z1]>1531) THEN ;
  10:  R[21:Z1Pos]=GI[6:ShftdFrame_Mac_Z1]-65536    ;
  11:  ELSE ;
  12:  R[21:Z1Pos]=GI[6:ShftdFrame_Mac_Z1]    ;
  13:  ENDIF ;
  14:  IF (GI[7:ShftdFrame_Mac_Z2]>1531) THEN ;
  15:  R[22:Z2Pos]=GI[7:ShftdFrame_Mac_Z2]-65536    ;
  16:  ELSE ;
  17:  R[22:Z2Pos]=GI[7:ShftdFrame_Mac_Z2]    ;
  18:  ENDIF ;
  19:   ;
  20:  IF (GI[8:ROB_GO_Shft_TCPX]>60000) THEN ;
  21:  R[81]=GI[8:ROB_GO_Shft_TCPX]-65536    ;
  22:  ELSE ;
  23:  R[81]=GI[8:ROB_GO_Shft_TCPX]    ;
  24:  ENDIF ;
  25:   ;
  26:  IF (GI[9:ROB_GO_Shft_TCPY]>60000) THEN ;
  27:  R[82]=GI[9:ROB_GO_Shft_TCPY]-65536    ;
  28:  ELSE ;
  29:  R[82]=GI[9:ROB_GO_Shft_TCPY]    ;
  30:  ENDIF ;
  31:   ;
  32:  IF (GI[10:ROB_GO_Shft_TCPZ]>60000) THEN ;
  33:  R[83]=GI[10:ROB_GO_Shft_TCPZ]-65536    ;
  34:  ELSE ;
  35:  R[83]=GI[10:ROB_GO_Shft_TCPZ]    ;
  36:  ENDIF ;
  37:   ;
  38:  IF (GI[11:ROB_GO_Shft_TCPW]>60000) THEN ;
  39:  R[84]=GI[11:ROB_GO_Shft_TCPW]-65536    ;
  40:  ELSE ;
  41:  R[84]=GI[11:ROB_GO_Shft_TCPW]    ;
  42:  ENDIF ;
  43:   ;
  44:  IF (GI[12:ROB_GO_Shft_TCPP]>60000) THEN ;
  45:  R[85]=GI[12:ROB_GO_Shft_TCPP]-65536    ;
  46:  ELSE ;
  47:  R[85]=GI[12:ROB_GO_Shft_TCPP]    ;
  48:  ENDIF ;
  49:   ;
  50:  IF (GI[13:ROB_GO_Shft_TCPR]>60000) THEN ;
  51:  R[86]=GI[13:ROB_GO_Shft_TCPR]-65536    ;
  52:  ELSE ;
  53:  R[86]=GI[13:ROB_GO_Shft_TCPR]    ;
  54:  ENDIF ;
  55:   ;
  56:  !-------------------------------- ;
  57:  ! SECTION 2: GAUGE ;
  58:  ! RA pos, TL, Homing ;
  59:  !-------------------------------- ;
  60:  R[3]=R[2:ANA_VAL_Z1]-.1    ;
  61:  R[11]=GI[1:Z1_ANGLE]    ;
  62:  R[13]=R[12]*10    ;
  63:  R[20]=GI[3:ShftdFrame_Mac_Y]/100    ;
  64:  R[34]=GI[2:RA_POS_CMD]    ;
  65:  R[35]=R[34]    ;
  66:  GO[22]=R[35] ;
  67:  //R[29]=R[35]+3    ;
  68:  GO[3:ROBOT_POS_FB]=R[35] ;
  69:  DO[17:TL_Green]=(DI[61:TL_Green]) ;
  70:  DO[18:TL_Red]=(DI[62:TL_Red]) ;
  71:  DO[19:TL_Amber]=(DI[63:TL_Amber]) ;
  72:  IF (F[1]),DO[63:ECAT_AutoHoming]=(ON) ;
  73:   ;
  74:  R[98:Z1Fcell]=R[2:ANA_VAL_Z1]*100    ;
  75:  R[99:Z2Fcell]=R[5:ANA_VAL_Z2]*100    ;
  76:  GO[4:Z1_Analog ]=R[98:Z1Fcell] ;
  77:  GO[5:Z2_Analog ]=R[99:Z2Fcell] ;
  78:  R[40:AngularVel]=GI[14:AngularVelo]/10    ;
  79:   ;
  80:  !-------------------------------- ;
  81:  ! SECTION 3: BG_POS ;
  82:  ! Current robot position readout ;
  83:  !-------------------------------- ;
  84:  IF (DI[65:ECAT_GetVal]) THEN ;
  85:   ;
  86:   ;
  87:  R[100]=$SV_INFO[1].$CART_POS_UF[1] ;
  88:  R[101]=$SV_INFO[1].$CART_POS_UF[2] ;
  89:  R[102]=$SV_INFO[1].$CART_POS_UF[3] ;
  90:  R[103]=$SV_INFO[1].$CART_POS_UF[4] ;
  91:  R[104]=$SV_INFO[1].$CART_POS_UF[5] ;
  92:  R[105]=$SV_INFO[1].$CART_POS_UF[6] ;
  93:  R[110:CurrWorldPosX]=R[100]*10    ;
  94:  R[111:CurrWorldPosY]=R[101]*10    ;
  95:  R[112:CurrWorldPosZ]=R[102]*10    ;
  96:  R[113:CurrWorldPosW]=R[103]*10    ;
  97:  R[114:CurrWorldPosP]=R[104]*10    ;
  98:  R[115:CurrWorldPosR]=R[105]*10    ;
  99:  ELSE ;
 100:  R[116:CurrPos_X]=$SV_INFO[1].$Axis_POS[1] ;
 101:  R[117:CurrPos_Y]=$SV_INFO[1].$Axis_POS[2] ;
 102:  R[118:CurrPos_Z]=$SV_INFO[1].$Axis_POS[3] ;
 103:  R[119:CurrPos_W]=$SV_INFO[1].$Axis_POS[4] ;
 104:  R[120:CurrPos_P]=$SV_INFO[1].$Axis_POS[5] ;
 105:  R[121:CurrPos_R]=$SV_INFO[1].$Axis_POS[6] ;
 106:  R[110:CurrWorldPosX]=R[116:CurrPos_X]*100    ;
 107:  R[111:CurrWorldPosY]=R[117:CurrPos_Y]*100    ;
 108:  R[112:CurrWorldPosZ]=R[118:CurrPos_Z]*100    ;
 109:  R[113:CurrWorldPosW]=R[119:CurrPos_W]*100    ;
 110:  R[114:CurrWorldPosP]=R[120:CurrPos_P]*100    ;
 111:  R[115:CurrWorldPosR]=R[121:CurrPos_R]*100    ;
 112:  ENDIF ;
 113:  GO[16]=R[110:CurrWorldPosX] ;
 114:  GO[17]=R[111:CurrWorldPosY] ;
 115:  GO[18]=R[112:CurrWorldPosZ] ;
 116:  GO[19]=R[113:CurrWorldPosW] ;
 117:  GO[20]=R[114:CurrWorldPosP] ;
 118:  GO[21]=R[115:CurrWorldPosR] ;
 119:   ;
 120:  IF (UI[4:Cycle stop]) THEN ;
 121:  DO[53:ECAT_StartProgram]=OFF ;
 122:  ENDIF ;
/POS
/END
